OPENROUTER_API_KEY=your-api-key
# Use an absolute file: path — the server cwd differs between dev and prod, and a
# relative path in dev lands in src/mastra/public (which gets copied into builds).
LOCAL_DATABASE_URL=file:/absolute/path/to/apps/mastra/mastra.db
GITHUB_PERSONAL_ACCESS_TOKEN=ghp_your_token
DISCORD_BOT_TOKEN=your-discord-bot-token
DISCORD_GENERAL_CHANNEL_ID=
OSS_REPORT_REPO_OWNER=mastra-ai
OSS_REPORT_REPO_NAME=mastra
# Slack incoming webhook used by the weekly scheduled report run
SLACK_WEBHOOK_URL=
# Optional base URL used for "View the full report" links in Slack messages
OSS_REPORT_PUBLIC_URL=
# Optional tuning for the oss-report workflow
OSS_REPORT_MAX_GENERAL_MESSAGES=200
OSS_REPORT_MAX_THREAD_MESSAGES=50
OSS_REPORT_RECURRING_THRESHOLD=0.82
